# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Secrets: the Fernet key must never leave the local machine ---
.env
*.key

# --- Generated by continuous learning; recreated on first startup ---
# (trailing space in the project folder name makes path-anchored patterns
# fragile, so these match the data directory wherever it lives)
**/data/report.json
**/data/learned_system.json
**/data/security.log
**/data/trades.db
**/data/*.db-wal
**/data/*.db-shm
**/data/*.json.tmp

# --- Frontend build output and dependencies ---
node_modules/
dist/

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/
